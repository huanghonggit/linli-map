# Copy this file to android/keystore.properties (gitignored) for Google Play Release AAB signing.
# Generate a release keystore with:
#   keytool -genkeypair -v -keystore android/linli-upload.jks -alias linli-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=../linli-upload.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=linli-upload
keyPassword=CHANGE_ME_KEY_PASSWORD
