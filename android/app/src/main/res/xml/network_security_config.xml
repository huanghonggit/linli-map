<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Store Release policy: enforce HTTPS / TLS across all domains for Google Play compliance -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
