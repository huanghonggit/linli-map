<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTPS public servers as well as LAN self-hosted backend servers for local family/community deployment -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
