# Optional public, origin-restricted Cesium ion access token with access to asset 2275207.
VITE_CESIUM_ION_TOKEN=

# Optional origin-restricted browser AK with Baidu panorama permission. Without it use official place / panorama pages.
VITE_BAIDU_PANO_AK=

# Default backend server URL baked into the Android APK (can also be changed inside the App login screen).
VITE_API_BASE_URL=https://111.228.54.20

# Backend API Server Configuration (server/index.js)
LINLI_API_HOST=0.0.0.0
LINLI_API_PORT=8787
LINLI_DB_PATH=./data/linli.sqlite
# Leave blank to auto-generate and persist a random 256-bit secret under ./data/.jwt-secret
LINLI_JWT_SECRET=
LINLI_ADMIN_USERNAME=admin
LINLI_ADMIN_PASSWORD=Admin@123456
